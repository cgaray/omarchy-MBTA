#!/usr/bin/env python3
import errno
import fcntl
import json
import os
import signal
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


ALLOWED_HOSTS = {"api-v3.mbta.com", "nominatim.openstreetmap.org"}
MBTA_RATE_LIMIT = 12
MBTA_RATE_WINDOW = 60


def rate_state_path():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    return os.path.join(runtime_dir, "omarchy-mbta-api-rate.json")


def update_rate_state(mutator):
    path = rate_state_path()
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(path, flags, 0o600)
    except OSError as error:
        # A missing or unwritable runtime directory (containers, sandboxes,
        # unusual PAM setups) is an environment gap, not abuse: degrade to
        # per-process limiting — the QML-side coordinator already keeps its
        # own cadence under the API budget — instead of blocking every MBTA
        # request forever. Symlinks and tampered files still fail closed via
        # the ownership checks below.
        if error.errno in (errno.ENOENT, errno.ENOTDIR, errno.EACCES,
                           errno.EPERM, errno.EROFS):
            return "uncoordinated"
        return None
    try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_mode & 0o077):
            return None
        fcntl.flock(fd, fcntl.LOCK_EX)
        try:
            raw = os.read(fd, 4096).decode("ascii", errors="ignore")
            state = json.loads(raw) if raw else {}
        except (ValueError, OSError):
            state = {}
        result = mutator(state)
        encoded = json.dumps(state, separators=(",", ":")).encode("ascii")
        os.lseek(fd, 0, os.SEEK_SET)
        os.ftruncate(fd, 0)
        os.write(fd, encoded)
        return result
    finally:
        os.close(fd)


def reserve_mbta_request(timeout):
    now = time.time()

    def reserve(state):
        timestamps = [float(value) for value in state.get("timestamps", [])
                      if isinstance(value, (int, float)) and float(value) > now - MBTA_RATE_WINDOW]
        timestamps.sort()
        blocked_until = float(state.get("blockedUntil", 0) or 0)
        scheduled = max(now, blocked_until)
        if len(timestamps) >= MBTA_RATE_LIMIT:
            scheduled = max(scheduled, timestamps[-MBTA_RATE_LIMIT] + MBTA_RATE_WINDOW)
        delay = scheduled - now
        if delay > max(0, timeout - 5):
            state["timestamps"] = timestamps[-MBTA_RATE_LIMIT:]
            return None
        timestamps.append(scheduled)
        state["timestamps"] = timestamps[-MBTA_RATE_LIMIT:]
        return max(0, delay)

    outcome = update_rate_state(reserve)
    if outcome is None:
        return False
    if outcome == "uncoordinated":
        return True
    if outcome > 0:
        time.sleep(outcome)
    return True


def block_mbta_requests(headers):
    try:
        reset = float(headers.get("x-ratelimit-reset", 0) or 0)
    except (TypeError, ValueError):
        reset = time.time() + MBTA_RATE_WINDOW
    if reset <= time.time():
        reset = time.time() + MBTA_RATE_WINDOW

    def block(state):
        state["blockedUntil"] = reset

    update_rate_state(block)


class NoRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, "redirect rejected", headers, fp)


def main():
    if len(sys.argv) != 4:
        return 2
    try:
        limit = int(sys.argv[1])
        timeout = int(sys.argv[2])
    except ValueError:
        return 2
    url = sys.argv[3]
    parsed = urllib.parse.urlsplit(url)
    if not 1 <= limit <= 4_194_304 or not 1 <= timeout <= 20:
        return 2
    try:
        port = parsed.port
    except ValueError:
        return 2
    if (len(url) > 4096 or parsed.scheme != "https" or parsed.hostname not in ALLOWED_HOSTS
            or parsed.username is not None or parsed.password is not None
            or port not in (None, 443)):
        return 2

    signal.alarm(timeout)
    if parsed.hostname == "api-v3.mbta.com" and not reserve_mbta_request(timeout):
        return 6
    request = urllib.request.Request(url, headers={
        "Accept": "application/json, text/plain;q=0.5",
        "Accept-Encoding": "identity",
        "User-Agent": "omarchy-mbta-plugin/1.0 (github.com/cgaray)",
    })
    opener = urllib.request.build_opener(NoRedirects)
    try:
        with opener.open(request, timeout=min(timeout, 5)) as response:
            if response.headers.get("Content-Encoding", "identity").lower() != "identity":
                return 3
            body = response.read(limit + 1)
    except urllib.error.HTTPError as error:
        if error.code == 429:
            block_mbta_requests(error.headers)
            return 6
        return 4
    except (OSError, urllib.error.URLError, ValueError):
        return 4
    if len(body) > limit:
        return 5
    sys.stdout.buffer.write(body)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
